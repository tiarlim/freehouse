DATABASE_URL=postgresql://USER:PASSWORD@HOST/freehouse?sslmode=verify-full
NEON_AUTH_BASE_URL=https://YOUR-ENDPOINT.neonauth.YOUR-REGION.aws.neon.tech/freehouse/auth
# Optional: defaults to NEON_AUTH_BASE_URL + /.well-known/jwks.json
# NEON_AUTH_JWKS_URL=https://YOUR-ENDPOINT.neonauth.YOUR-REGION.aws.neon.tech/freehouse/auth/.well-known/jwks.json
# Optional direct connection for manual migrations; do not expose it to the browser.
# DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@HOST/freehouse?sslmode=verify-full
PORT=4187
APP_ORIGIN=http://localhost:4187
# HOST=127.0.0.1
# On Render, omit APP_ORIGIN to use RENDER_EXTERNAL_URL automatically.
